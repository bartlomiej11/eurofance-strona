---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import PostCard from '../../components/PostCard.astro';
import CtaBar from '../../components/CtaBar.astro';
import { posts, blogCategories, postsPage, blogPagesCount, categoryUrl } from '../../lib/content.js';
import * as LD from '../../lib/jsonld.js';

const list = postsPage(1);
const pagesCount = blogPagesCount();

const nodes = [
  LD.breadcrumbs([{ name: 'Blog', url: '/blog/' }]),
  LD.itemList('Najnowsze wpisy', list.map((p) => ({ name: p.title, url: `/blog/${p.slug}/` }))),
  { '@type': 'Blog', name: 'Blog Eurofance', url: 'https://eurofance.pl/blog/', inLanguage: 'pl-PL', publisher: { '@id': 'https://eurofance.pl/#firma' } },
];
---
<Base
  title="Blog o ogrodzeniach: poradniki, ceny i montaż | Eurofance"
  description="Poradniki o ogrodzeniach panelowych, palisadowych i bramach wjazdowych. Ceny, wymiary, montaż, przepisy i wybór koloru RAL. Pisze producent, Eurofance."
  path="/blog/"
  jsonld={nodes}
>
  <Breadcrumbs items={[{ name: 'Blog' }]} />
  <section class="section">
    <div class="container">
      <h1>Blog o ogrodzeniach</h1>
      <p class="answer">
        Piszemy o tym, co sami produkujemy: ogrodzeniach panelowych 2D i 3D, palisadowych, bramach przesuwnych i skrzydłowych.
        W każdym wpisie znajdziesz liczby: ceny „od”, wymiary, czas montażu i konkretne rozwiązania.
      </p>
      <div class="two-col">
        <div class="post-list">
          {list.map((post) => <PostCard post={post} />)}
        </div>
        <aside>
          <div class="sidebar-cta">
            <h2 style="font-size:1.1rem">Wycena ogrodzenia</h2>
            <p>Podaj długość i miejscowość, wycenę z montażem wyślemy w 24 h w dni robocze.</p>
            <div class="btn-row">
              <a class="btn btn--red btn--wide" href="tel:+48579775729" data-cta="blog-sidebar">Zadzwoń: 579 775 729</a>
              <a class="btn btn--outline btn--wide" href="/bezplatna-wycena" data-cta="blog-sidebar">Bezpłatna wycena</a>
            </div>
          </div>
          <div class="sidebar-cta" style="margin-top:16px">
            <h2 style="font-size:1.1rem">Kategorie</h2>
            <ul class="list-arrow">
              {blogCategories.map((cat) => (
                <li><a href={categoryUrl(cat.slug)}>{cat.name}</a></li>
              ))}
            </ul>
            <p><a href="/blog/encyklopedia/">Encyklopedia ogrodzeń</a></p>
          </div>
        </aside>
      </div>

      {pagesCount > 1 && (
        <nav class="pagination" aria-label="Stronicowanie bloga">
          <span class="is-current">1</span>
          {Array.from({ length: pagesCount - 1 }, (_, i) => i + 2).map((n) => (
            <a href={`/blog/page/${n}/`}>{n}</a>
          ))}
        </nav>
      )}

      <CtaBar text="Nie wiesz, który system wybrać?" desc="Zadzwoń, powiemy w 5 minut, co pasuje do Twojej działki i ile to kosztuje." place="blog" />
    </div>
  </section>
</Base>