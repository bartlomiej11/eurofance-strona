---
import site from '../data/site.json';
import { tk } from '../lib/tk.js';
import SmartImage from './SmartImage.astro';
import ContactForm from './ContactForm.astro';

const {
  h1,
  answer,
  image = '/images/premium/realizacja-2.jpg',
  ctaSecondary = 'Bezpłatna wycena',
  showForm = true,
  category = '',
  variantKey = null,
  eyebrow = '',
} = Astro.props;

const phoneHref = `tel:${site.phone.tel}`;
---
<section class="hero" data-hero>
  <div class="hero__media" aria-hidden="true">
    <SmartImage src={image} alt="" width={1600} height={900} loading="eager" fetchpriority="high" />
  </div>
  <div class="container hero__in">
    <div>
      {eyebrow && <span class="eyebrow">{tk(eyebrow)}</span>}
      <h1>{tk(h1)}</h1>
      <p class="hero__answer answer" data-hero-sub>{tk(answer)}</p>
      <div class="btn-row">
        <a class="btn btn--red" href={phoneHref} data-cta="hero">
          Zadzwoń: {site.phone.short}
        </a>
        <a class="btn btn--outline-light" href="/bezplatna-wycena" data-cta="hero" data-hero-cta>{ctaSecondary}</a>
      </div>
      <div class="hero__badges">
        <span class="badge">
          <span class="stars" aria-hidden="true">★★★★★</span>
          <a
            class="rating-btn"
            href={site.googleRating.url}
            target="_blank"
            rel="noopener nofollow"
            data-cta="opinie-google"
            title="Zobacz opinie w Google"
          >
            <span class="rating-btn__stars" aria-hidden="true">★★★★★</span>
            <span class="rating-btn__value">{site.googleRating.value}/5</span>
            <span class="rating-btn__count">{site.googleRating.count} opinii w Google</span>
            <span class="rating-btn__arrow" aria-hidden="true">Zobacz →</span>
          </a>
        </span>
        <span class="badge">Gwarancja {site.warranty}</span>
        <span class="badge">Własna produkcja i malarnia</span>
        <span class="badge">Montaż w całej Polsce</span>
        <span class="badge">Odpowiadamy w {site.stats.responseTime} w dni robocze</span>
      </div>
      <p class="kalend" style="margin-top:12px">{site.hours.line}. {site.hours.afterHours}</p>
    </div>
    {showForm && (
      <div class="hero__panel">
        <ContactForm
          place="hero"
          category={category}
          title="Formularz kontaktowy"
          desc="Napisz, czego potrzebujesz. Odpowiemy w ciągu 2 h w dni robocze."
          compact={true}
        />
      </div>
    )}
  </div>
  {variantKey && <span hidden data-hero-variant={variantKey}></span>}
</section>
