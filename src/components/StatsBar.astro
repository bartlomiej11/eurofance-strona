---
import { tk } from '../lib/tk.js';
import site from '../data/site.json';

const { items = [], eyebrow = '', title = '', lead = '', sectionClass = 'section--dark' } = Astro.props;

const domyslne = [
  { value: `${site.stats.years}`, label: 'lat na rynku' },
  { value: `${site.stats.realizacje}`, label: 'zrealizowanych ogrodzeń' },
  { value: `${site.stats.teams}`, label: 'własnych ekip montażowych' },
  { value: site.warranty, label: 'gwarancji na konstrukcję i powłokę' },
];

const lista = items.length ? items : domyslne;
---
<section class={`section ${sectionClass}`.trim()}>
  <div class="container">
    {(eyebrow || title || lead) && (
      <div class="section-head">
        {eyebrow && <span class="eyebrow">{tk(eyebrow)}</span>}
        {title && <h2>{tk(title)}</h2>}
        {lead && <p class="lead" set:html={tk(lead)} />}
      </div>
    )}
    <div class="stats">
      {lista.map((item) => (
        <div class="stat">
          <span class="stat__value">{tk(item.value)}</span>
          <span class="stat__label">{tk(item.label)}</span>
        </div>
      ))}
    </div>
  </div>
</section>