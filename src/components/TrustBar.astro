---
import site from '../data/site.json';
const { showLogos = true } = Astro.props;
---
<div class="trust">
  <span class="stars" aria-hidden="true">★★★★★</span>
  <a
    class="rating-btn rating-btn--inline"
    href={site.googleRating.url}
    target="_blank"
    rel="noopener nofollow"
    data-cta="opinie-google"
  >
    <span class="rating-btn__stars" aria-hidden="true">★★★★★</span>
    <span class="rating-btn__value">{site.googleRating.value}/5</span>
    <span class="rating-btn__count">{site.googleRating.count} opinii w Google</span>
  </a>
  <span><strong>Gwarancja {site.warranty}</strong></span>
  <span>{site.stats.teams} ekip montażowych</span>
  <span>{site.stats.realizacje} realizacji</span>
  <span>Produkcja: {site.address.city}</span>
</div>
{showLogos && (
  <div class="logos" aria-label="Zaufali nam">
    {site.clients.map((client) => <span>{client}</span>)}
  </div>
)}